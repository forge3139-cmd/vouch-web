# Supabase — service-role client used server-side only (see lib/supabase.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase publishable (anon) key — server-only here. Sign-in and sign-up run
# as Server Actions and the session lives in HttpOnly cookies, so there is no
# browser-side Supabase client and nothing to expose with NEXT_PUBLIC_.
# Same key the mobile app calls EXPO_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_PUBLISHABLE_KEY=
